{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Phase E Publication Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "loopId", "repository", "sourceReceiptId", "remote", "pullRequest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "phase_e_remote_pr" },
    "loopId": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "sourceReceiptId": { "type": "string", "minLength": 3 },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "branch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseBranch", "title", "body", "draft", "requiredChecks", "humanReviewRequired", "minApprovals"],
      "properties": {
        "baseBranch": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "draft": { "const": false },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "humanReviewRequired": { "const": true },
        "minApprovals": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    }
  }
}
